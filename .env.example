# ============================================================
# SIMAP WILKERSTAT - Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit .env ke Git.
# ============================================================

APP_NAME="SIMAP Wilkerstat"
APP_ENV=development            # development | production
APP_DEBUG=true                 # true di dev, false di production
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id_ID

# Kunci aplikasi (32 byte base64). Generate dengan: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simap_wilkerstat
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Cookie
SESSION_NAME=SIMAP_SESSID
SESSION_LIFETIME=7200          # detik (2 jam)
SESSION_SECURE=false           # true jika HTTPS
SESSION_SAMESITE=Lax

# Rate limit login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900         # 15 menit

# Path storage (relatif ke root proyek)
STORAGE_PATH=storage